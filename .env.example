DATABASE_URL=sqlite:///D:/final/data/niam.db
DATA_DIR=D:/final/data
REGULATORY_SOURCE_URL=https://regulatory-source-portal.vercel.app/regulations
SYNC_INTERVAL_MINUTES=5
SYNC_ENABLED=true
# Set SYNC_ENABLED=false in the API service when running the separate worker.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave blank for local Vite proxy; set to deployed API origin for a production build.
VITE_API_BASE_URL=
GEMINI_API_KEY=
MAX_PDF_BYTES=26214400
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Configure both values only in the private local .env. Never commit the secret.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
